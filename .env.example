# Canadian IPTV Player - Environmental Configuration

# Server Port
PORT=3000

# Node Environment
NODE_ENV=development

# IPTV-org Configuration
IPTV_ORG_ENABLED=true
IPTV_PLAYLIST_FORMAT=m3u

# EPG Settings
EPG_DATABASE_PATH=./data/epg
EPG_YEAR_RANGE_START=2005
EPG_YEAR_RANGE_END=2013

# Logging
LOG_LEVEL=info
